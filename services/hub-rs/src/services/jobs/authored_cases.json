    {
      "name": "guarded: only if the disk is full",
      "spec": {
        "name": "Disk pressure",
        "enabled": true,
        "trigger": {
          "kind": "interval",
          "everyMinutes": 60
        },
        "action": {
          "kind": "spawn",
          "spawn": {
            "cwd": "/home/me/ops",
            "prompt": "Disk is filling up:\n{{output}}\nFind the biggest offenders and propose cleanup.",
            "context": [
              {
                "kind": "shell",
                "shell": {
                  "command": "df -h | awk '$5+0 > 90'"
                },
                "skipIfEmpty": true,
                "ignoreExitCode": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "two steps, indexed placeholders",
      "spec": {
        "name": "Nightly digest",
        "enabled": true,
        "trigger": {
          "kind": "daily",
          "at": "22:00"
        },
        "action": {
          "kind": "spawn",
          "spawn": {
            "cwd": "/home/me/api",
            "prompt": "Commits:\n{{output.1}}\n\nSessions today:\n{{output.2}}\n\nWrite DIGEST.md.",
            "context": [
              {
                "kind": "shell",
                "shell": {
                  "command": "git log --oneline --since=1.day"
