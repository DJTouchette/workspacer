# Dependencies & build output (match at any depth across the monorepo).
# node_modules deliberately has NO trailing slash: agent worktrees get their
# node_modules as a SYMLINK to the source checkout's, and a dir-only pattern
# (`node_modules/`) would not match a symlink, leaving it untracked.
node_modules
dist/
release/
*.js.map
.DS_Store

# Rust target dirs (apps/tui, services/claudemon)
target/

# hub build artifacts (built by `npm run build:hub` / `npm run build:mcp`)
services/hub/hub
services/hub/mcp
services/hub/brain
services/hub/workspacer
services/hub/claudemon
services/hub/*.exe
# Go renames a locked (running) binary to <name>.exe~ when it can't overwrite it.
services/hub/*.exe~

# Committed binaries don't belong in source control (deleted from history going forward)
/bin/
/workspacer

# A global ignore (~/.gitignore_global) has a `claude/` rule (meant for `.claude/`)
# that wrongly matches this source directory, so new files in it were silently
# untracked. Re-include the directory and its contents for this repo.
!apps/desktop/src/renderer/src/components/claude/
!apps/desktop/src/renderer/src/components/claude/**

# Per-plugin bus tokens are minted at runtime; never commit them.
.bus-token

# Workspacer runtime state in a project dir (saved workflows, etc.) — never commit.
.workspacer/

# Playwright run artefacts (traces, failure screenshots) from the e2e suites.
apps/desktop/test-results/

# Rivet — hand-authored project knowledge (.rivet/context, .rivet/learnings,
# .rivet/hooks, .rivet/runbooks, .rivet/config.yaml) IS tracked, since CLAUDE.md
# tells every dispatched agent to read it. These are generated indexes/caches
# that rebuild locally via `rivet serve` and must never be committed.
.recon/
.rivet/embeddings/
.rivet/recon/

# Stray nested .rivet/ (rivet was run once with cwd set here by mistake) —
# not the project's real context root; left in place, untracked, for a human
# to fold into /.rivet/learnings or delete. See CLAUDE.md's .rivet/ for the
# real tracked context.
apps/desktop/src/renderer/.rivet/
