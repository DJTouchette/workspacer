#!/usr/bin/env bash
# Launch the release build of Workspacer Native with its embedded backend
# (hub, session engine and MCP tools in the app's own process). Arguments pass
# through to wks-native, e.g. `./run-workspacer --keep-running`.
#
# Build it first with `make build-native`. This used to start the Electron
# AppImage with remote sharing forced on (WORKSPACER_REMOTE_SHARE=1); the native
# app does not read that variable, so nothing is forced here. That Electron
# loop is still `make dev-share`.
set -euo pipefail
BINARY="$(dirname "$0")/apps/native/target/release/wks-native"
if [[ ! -x "$BINARY" ]]; then
  echo "wks-native not found at $BINARY — build it with: make build-native" >&2
  exit 1
fi
exec "$BINARY" --local "$@"
