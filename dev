#!/usr/bin/env bash
# Run Workspacer in dev mode from the repo root: the native app (debug build)
# with its embedded Rust backend. Same as `make dev`; arguments pass through,
# e.g. `./dev --keep-running`.
#
# The deprecated Electron loop is `make dev-desktop`.
set -euo pipefail
cd "$(dirname "$0")"
exec cargo run --locked --manifest-path apps/native/Cargo.toml -- --local "$@"
