      "config": {
        "defaultModel": "opus",
        "contextWindow": 1000000,
        "skipPermissionsDefault": true,
        "defaultPermissionMode": "bypassPermissions",
        "seenModels": []
      },
      "live": [],
      "expected": {
        "defaultModel": "opus",
        "contextWindow": 1000000,
        "skipPermissionsDefault": true,
        "defaultPermissionMode": "bypassPermissions",
        "aliases": [
          {
            "model": "fable",
            "value": "fable",
            "label": "Fable",
            "contextWindow": 1000000,
            "context": "1M"
          },
          {
            "model": "opus",
            "value": "opus",
            "label": "Opus",
            "contextWindow": 200000,
            "context": "200K"
          },
          {
            "model": "opus",
            "value": "opus[1m]",
            "label": "Opus",
            "contextWindow": 1000000,
            "context": "1M"
          },
          {
            "model": "sonnet",
