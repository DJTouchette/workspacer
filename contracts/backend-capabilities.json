  "architecturalRetirements": {
    "plugins.prepareLaunch": {
      "reason": "Private callback from the Go brain process is replaced by owned in-process launch integration with actor-verified launch authority. External plugin prepare methods remain callable only through the validated integration path.",
      "replacement": "services/hub-rs/src/plugins/launch.rs",
      "tests": "services/hub-rs/src/plugins/launch/tests.rs"
    }
  },
  "currentAdditions": {
    "fs.compareWrite": {
      "authority": "fs.write",
      "reason": "Rust host conditional file write: the same authenticated ambient host-path authority as fs.write. Canonical absolute path selects the file; contents and expected are inert text, force only bypasses the content comparison. None grants provider, process, permission or caller-identity authority."
    },
    "claude.handoffSummaryBrief": {
      "authority": "claude.handoffBrief",
      "reason": "Rust live-controls handoff tier between the mechanical and agent briefs: the caller supplies only a validated session id. The hub builds the same deterministic digest plus a bounded, credential-masked conversation tail, asks its configured title harness (Haiku for Claude) for one tool-less completion, and writes a hub-named file under ~/.workspacer/handoffs, falling back to the mechanical brief. No caller path, argv, model, provider or permission reaches the process, and nothing is sent to the source session."
    }
  }
