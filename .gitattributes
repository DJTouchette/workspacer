# Captured portable contracts and their retained Go references are hashed byte
# for byte. Keep checkout bytes identical on Windows (core.autocrlf=true) rather
# than weakening those guards with content or whitespace normalization.
/contracts/**/*.json text eol=lf
/services/hub/**/*.go text eol=lf
/apps/desktop/tests/fixtures/capability-parameter-vocabulary.json text eol=lf
/tools/capability-source-check/go-reference.json text eol=lf
/services/hub-rs/assets/mcp-*.json text eol=lf
# Immutable collaboration assets share an exact content hash across launchers.
/apps/desktop/assets/skills/project-brief/SKILL.md text eol=lf
/apps/desktop/assets/skills/spawn-agent/SKILL.md text eol=lf
/apps/desktop/src/main/services/agentCollaborationSkills.generated.json text eol=lf
/apps/desktop/src/main/shared/managerDoctrine.ts text eol=lf
/apps/desktop/src/main/shared/fleetWorkflow.ts text eol=lf
/services/hub-rs/assets/launch-instructions.json text eol=lf
# Retained non-Go assets keep captured byte provenance across platform checkouts.
/services/hub/examples/** text eol=lf
/plugins/examples/** text eol=lf
# This captured third-party bundle retains upstream whitespace and a pinned hash.
/plugins/examples/editor/ui/cm.bundle.js -whitespace
/plugins/examples.provenance.json text eol=lf
/services/hub/internal/routing/testdata/preferences-view.json text eol=lf
/apps/desktop/tests/fixtures/routing-preferences-view.json text eol=lf
