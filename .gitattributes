# Captured portable contracts and their retained Go references are hashed byte
# for byte. Keep checkout bytes identical on Windows (core.autocrlf=true) rather
# than weakening those guards with content or whitespace normalization.
/contracts/**/*.json text eol=lf
/services/hub/**/*.go text eol=lf
/apps/desktop/tests/fixtures/capability-parameter-vocabulary.json text eol=lf
/tools/capability-source-check/go-reference.json text eol=lf
/services/hub-rs/assets/mcp-*.json text eol=lf
